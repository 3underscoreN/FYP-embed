[Unit]
Description=FYP Embed FastAPI service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/fyp-embed
ExecStart=/opt/fyp-embed/.venv/bin/uvicorn fyp_embed.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target